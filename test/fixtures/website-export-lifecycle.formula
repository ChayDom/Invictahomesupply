=IFNA(LET(keys,FILTER('Product Catalog'!AA2:AA,'Product Catalog'!AA2:AA<>""),field,LAMBDA(column,MAP(keys,LAMBDA(k,XLOOKUP(k,'Product Catalog'!AA:AA,column,"")))),qty,MAP(keys,LAMBDA(k,XLOOKUP(k,'Lifecycle Inventory'!A:A,ARRAYFORMULA(IF(ISNUMBER('Lifecycle Inventory'!C:C),'Lifecycle Inventory'!C:C,"")),""))),pack,field('Product Catalog'!I:I),avail,MAP(qty,pack,LAMBDA(q,p,IF(AND(ISNUMBER(q),q>=0,ISNUMBER(p),p>0),q*p,""))),HSTACK(keys,field('Product Catalog'!A:A),field('Product Catalog'!F:F),field('Product Catalog'!D:D),field('Product Catalog'!E:E),field('Product Catalog'!C:C),field('Product Catalog'!B:B),qty,field('Product Catalog'!H:H),pack,avail,field('Product Catalog'!J:J),field('Product Catalog'!P:P),field('Product Catalog'!Q:Q),field('Product Catalog'!O:O),field('Product Catalog'!N:N),field('Product Catalog'!M:M),field('Product Catalog'!Y:Y),MAP(qty,LAMBDA(q,AND(ISNUMBER(q),q>0))),field('Product Catalog'!L:L))),"")
